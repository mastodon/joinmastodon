{
  "name": "joinmastodon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "yarn typecheck && yarn lint-js && yarn lint-roadmap",
    "lint-js": "eslint .",
    "lint-roadmap": "tsx scripts/lint-roadmap.ts",
    "fix": "yarn lint --fix",
    "format": "prettier --write --log-level warn --ignore-unknown .",
    "update-sponsors": "node --experimental-fetch patreon.mjs",
    "extract": "formatjs extract '{components,pages,data}/**/*.{js,jsx,ts,tsx}' --out-file 'locales/en.json' --format 'locales/locale_format.js'",
    "typecheck": "tsc --noEmit && echo 'No type errors'"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^7.9.0",
    "@tanstack/react-query": "^5.101.4",
    "blurhash": "^2.0.5",
    "classnames": "^2.5.1",
    "cookie": "^2.0.0",
    "dotenv": "^16.6.1",
    "gray-matter": "^4.0.3",
    "javascript-stringify": "^2.1.0",
    "keen-slider": "^6.8.6",
    "lodash": "^4.18.1",
    "next": "^15.5.23",
    "node-gyp": "^13.0.1",
    "react": "^18.3.1",
    "react-blurhash": "^0.3.0",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.14",
    "react-markdown": "^10.1.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "stripe": "^18.5.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@formatjs/cli": "^6.16.16",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-logical": "^3.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.9.1"
}
